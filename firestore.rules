rules_version = '2';

// Setiap user hanya boleh mengakses data di bawah users/{uid} miliknya sendiri,
// dan setiap dokumen yang ditulis harus sesuai bentuk di src/lib/types.ts.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidTransaction(data) {
      return data.keys().hasOnly(['type', 'amount', 'category', 'date', 'note', 'createdAt'])
        && data.keys().hasAll(['type', 'amount', 'category', 'date', 'note'])
        && data.type in ['income', 'expense']
        && data.amount is number && data.amount > 0
        && data.category is string && data.category.size() > 0 && data.category.size() <= 50
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.note is string && data.note.size() <= 500
        && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidCategoryName(name) {
      return name is string && name.size() > 0 && name.size() <= 50;
    }

    // `category` opsional: kategori pengeluaran yang terhubung ke target
    function isValidGoal(data) {
      return data.keys().hasOnly(['name', 'targetAmount', 'currentAmount', 'category'])
        && data.keys().hasAll(['name', 'targetAmount', 'currentAmount'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.targetAmount is number && data.targetAmount > 0
        && data.currentAmount is number && data.currentAmount >= 0
        && (!('category' in data) || isValidCategoryName(data.category));
    }

    // ID dokumen budget = ID dokumen kategori (budget lama memakai ID seperti 'makan-jajan')
    function isValidBudget(data) {
      return data.keys().hasOnly(['category', 'limit'])
        && data.keys().hasAll(['category', 'limit'])
        && isValidCategoryName(data.category)
        && data.limit is number && data.limit > 0;
    }

    function isValidCategory(data) {
      return data.keys().hasOnly(['name', 'icon', 'type', 'savings', 'createdAt'])
        && data.keys().hasAll(['name', 'icon', 'type', 'savings'])
        && isValidCategoryName(data.name)
        && data.icon is string && data.icon.matches('^[a-z0-9-]{1,40}$')
        && data.type in ['income', 'expense']
        && data.savings is bool && (data.type == 'expense' || data.savings == false)
        && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    match /users/{userId}/transactions/{txId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidTransaction(request.resource.data);
    }

    match /users/{userId}/goals/{goalId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidGoal(request.resource.data);
    }

    match /users/{userId}/budgets/{budgetId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidBudget(request.resource.data);
    }

    match /users/{userId}/categories/{categoryId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidCategory(request.resource.data);
    }

    // Selain path di atas, semuanya ditolak.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
