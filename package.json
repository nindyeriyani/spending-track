{
  "name": "spending-track",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-spending-track \"vitest run --config vitest.rules.config.mts\"",
